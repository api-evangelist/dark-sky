          "id": "8a35eef4-74a4-4486-b494-dd466b8259e1",
          "name": "Time Machine — historical or future weather data",
          "request": {
            "name": "Time Machine — historical or future weather data",
            "description": {
              "content": "Returns the observed (or forecast) weather conditions for a specific point in time. The time parameter may be a Unix timestamp (seconds since epoch) or an ISO 8601 datetime string. Historical requests return data based on station observations; future requests return forecast data.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "forecast",
                ":key",
                "{{latitude}},{{longitude}},{{time}}"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "exclude",
                  "value": "<string>",
                  "description": "Comma-separated list of data blocks to exclude from the response. Excluding unneeded blocks reduces latency and conserves bandwidth.\n"
                },
                {
                  "disabled": false,
                  "key": "lang",
                  "value": "en",
                  "description": "Returns text summaries in the given language. Defaults to \"en\" (English).\n"
                },
                {
                  "disabled": false,
                  "key": "units",
                  "value": "auto",
                  "description": "Returns weather conditions in the requested units. Defaults to \"auto\". - auto: Automatically selects units based on geographic location. - ca: SI units, but with km/h for wind speed. - si: SI units (m/s for wind speed, Celsius for temperature). - uk2: SI units, but with miles for visibility and mph for wind speed. - us: Imperial units (the default for the United States).\n"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "key",
                  "description": "(Required) Your Dark Sky API secret key."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
