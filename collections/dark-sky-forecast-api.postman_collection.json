  "item": [
    {
      "id": "cefd20d7-7d59-4e44-bdb2-6bf382f12913",
      "name": "Forecast",
      "description": {
        "content": "Current and forecast weather data for a given location",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "5239f9f7-973a-44e5-a33a-614c1c605135",
          "name": "Current and forecast weather data",
          "request": {
            "name": "Current and forecast weather data",
            "description": {
              "content": "Returns the current weather conditions and forecast for the given latitude and longitude. The response always contains a currently data point, and may contain minutely, hourly, daily, alerts, and flags data blocks depending on the exclude parameter and data availability.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "forecast",
                ":key",
                "{{latitude}},{{longitude}}"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "exclude",
                  "value": "<string>",
                  "description": "Comma-separated list of data blocks to exclude from the response. Excluding unneeded blocks reduces latency and conserves bandwidth.\n"
                },
                {
                  "disabled": false,
                  "key": "extend",
                  "value": "<string>",
                  "description": "When set to \"hourly\", returns hourly data for the next 168 hours (7 days) rather than the default 48 hours.\n"
                },
                {
                  "disabled": false,
                  "key": "lang",
                  "value": "en",
                  "description": "Returns text summaries in the given language. Defaults to \"en\" (English).\n"
                },
                {
                  "disabled": false,
                  "key": "units",
                  "value": "auto",
                  "description": "Returns weather conditions in the requested units. Defaults to \"auto\". - auto: Automatically selects units based on geographic location. - ca: SI units, but with km/h for wind speed. - si: SI units (m/s for wind speed, Celsius for temperature). - uk2: SI units, but with miles for visibility and mph for wind speed. - us: Imperial units (the default for the United States).\n"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "key",
                  "description": "(Required) Your Dark Sky API secret key."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
